{
    "name": "authentik-browser-ext",
    "version": "0.44.3",
    "description": "Authentik Application Launcher Chrome Extension",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix",
        "lint:check": "oxlint --max-warnings=0",
        "type-check": "tsc --noEmit -p .",
        "watch": "rollup -c -w"
    },
    "devDependencies": {
        "@codecov/rollup-plugin": "^2.0.1",
        "@goauthentik/api": "^2026.8.2",
        "@goauthentik/oxfmt-config": "^9.1.0",
        "@goauthentik/oxlint-config": "^1.0.0",
        "@goauthentik/tsconfig": "^2.0.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@sentry/browser": "^10.73.0",
        "@types/chrome": "^0.2.9",
        "fuse.js": "^7.5.0",
        "lit": "^3.3.3",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "rollup": "^4.63.1",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=24"
    }
}
