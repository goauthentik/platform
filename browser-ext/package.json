{
    "name": "authentik-browser-ext",
    "version": "0.44.3",
    "description": "Authentik Application Launcher Chrome Extension",
    "type": "module",
    "scripts": {
        "build": "node build.mjs",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --fix",
        "lint:check": "oxlint --max-warnings=0",
        "type-check": "tsc --noEmit -p .",
        "watch": "node build.mjs --watch"
    },
    "devDependencies": {
        "@goauthentik/api": "^2026.8.3",
        "@goauthentik/oxfmt-config": "^9.1.0",
        "@goauthentik/oxlint-config": "^1.0.0",
        "@goauthentik/tsconfig": "^2.0.0",
        "@sentry/browser": "^10.75.1",
        "@types/chrome": "^0.3.0",
        "esbuild": "^0.28.2",
        "fuse.js": "^7.5.0",
        "lit": "^3.3.3",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24"
    }
}
