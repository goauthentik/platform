<?xml version="1.0" encoding="UTF-8"?>
<?define Name = "authentik Agent" ?>
<?define Manufacturer = "Authentik Security Inc" ?>
<?define Version = "$(env.VERSION)" ?>
<?define UpgradeCode = "3200363b-996e-4fd7-ae14-e3a425132b63" ?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Id="authentik.Agent"
           Name="$(var.Name)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeCode)"
           Compressed="true">
    <ui:WixUI Id="AK_WixUI_FeatureTree"
              InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUIDialogBmp" Value="$(env.PWD)/resources/WixUIDialogBmp.png" />
    <WixVariable Id="WixUIBannerBmp" Value="$(env.PWD)/resources/WixUIBannerBmp.png" />

    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit." />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.Manufacturer)">
        <Directory Id="sysd" Name="sysd" />
        <Directory Id="browser_support" Name="browser_support" />
        <Directory Id="wcp" Name="wcp" />
        <Directory Id="cli" Name="cli" />
        <Directory Id="agent" Name="agent" />
      </Directory>
    </StandardDirectory>
    <!-- Every binary in this package links the MSVC runtime dynamically: the
         Rust standard library already needs vcruntime140.dll, and aws-lc-sys
         compiles BoringSSL's C++ with FH4 exception handling, which is what
         adds vcruntime140_1.dll on top. -->
    <StandardDirectory Id="TARGETDIR">
      <Merge Id="VCRedistCRT"
             SourceFile="$(env.VC_REDIST_MSM)"
             DiskId="1"
             Language="0" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="ak_ProgramDataRoot" Name="$(var.Manufacturer)">
      </Directory>
    </StandardDirectory>
    <!-- ak-agent-desktop.exe and ak_browser.exe are both Tauri apps, so they
         render through the machine's Evergreen WebView2 runtime and there is
         nothing to fall back to when it is absent. Windows 11 ships it as part
         of the OS and most Windows 10 devices picked it up through Windows
         Update, but neither is a guarantee (LTSC, Server and imaged machines
         turn up without it), so detect it and install it when it is
         missing. -->
    <Property Id="WEBVIEW2_VERSION">
      <RegistrySearch Id="webview2_version"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv"
                      Type="raw"
                      Bitness="always32" />
    </Property>

    <!-- The Evergreen bootstrapper is a ~2MB stub that pulls the runtime
         matching the machine's architecture from Microsoft; the Makefile
         fetches it at build time so it rides inside the signed MSI. Deferred
         and non-impersonated so it runs elevated, which is what makes the
         install per-machine rather than per-user. Return="check" fails the
         install if it cannot be installed: an offline machine ends up with no
         agent rather than an agent whose windows never open, and a
         credential provider registered on the logon screen that cannot
         render is the worse of the two outcomes. -->
    <Binary Id="webview2_bootstrapper" SourceFile="$(env.WEBVIEW2_BOOTSTRAPPER)" />
    <CustomAction Id="install_webview2"
                  BinaryRef="webview2_bootstrapper"
                  ExeCommand="/silent /install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <InstallExecuteSequence>
      <Custom Action="install_webview2"
              Before="InstallFinalize"
              Condition="NOT REMOVE AND (NOT WEBVIEW2_VERSION OR WEBVIEW2_VERSION = &quot;0.0.0.0&quot;)" />
    </InstallExecuteSequence>

    <Icon Id="authentik_icon" SourceFile="$(env.PWD)/resources/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="authentik_icon" />
    <util:CloseApplication Id="ak_agent_close"
                            Target="ak-agent-desktop.exe"
                            TerminateProcess="1"
                            RebootPrompt="no" />

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="sysd" Guid="bf7159f6-802c-42ed-8cc7-1866bf844e29" Bitness="always64" Directory="sysd">
        <CreateFolder Directory="ak_ProgramDataRoot" Subdirectory="domains" />
        <CreateFolder Directory="ak_ProgramDataRoot" Subdirectory="runtime" />
        <File Id="ak_sysd"
              Source="$(env.ROOT)/bin/sysd/ak-sysd.exe"
              KeyPath="true" />
        <File Id="ak_sysd_config"
              Source="$(env.PWD)/config.json" />

        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\authentik" />
        <util:EventSource Log="authentik"
                          Name="authentik System Service"
                          EventMessageFile="[#ak_sysd]"/>

        <ServiceInstall Id="ServiceInstaller"
                        Type="ownProcess"
                        Name="ak_sysd"
                        DisplayName="$(Name)"
                        Description="authentik System Agent."
                        Start="auto"
                        ErrorControl="normal"
                        Arguments="agent" />

        <ServiceControl Id="StartService"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Name="ak_sysd"
                        Wait="true" />
      </Component>
      <Component Id="agent" Bitness="always64" Directory="agent">
        <util:EventSource Log="authentik"
                          Name="authentik User Service"
                          EventMessageFile="[#ak_agent]"/>
        <File Id="ak_agent"
              Source="$(env.ROOT)/bin/agent-desktop/ak-agent-desktop.exe"
              KeyPath="true" />
      </Component>
      <Component Id="cli" Bitness="always64" Directory="cli">
        <util:EventSource Log="authentik"
                          Name="authentik CLI"
                          EventMessageFile="[#ak_cli]"/>
        <File Id="ak_cli"
              Source="$(env.ROOT)/bin/cli/ak.exe"
              KeyPath="true" />
      </Component>
      <Component Id="cli_path" Bitness="always64" Guid="b7367ded-3915-4c37-a468-5a58618e37fd">
        <Environment Id="PATH"
                     Name="PATH"
                     Value="[cli]"
                     Permanent="yes"
                     Part="last"
                     Action="set"
                     System="yes" />
      </Component>
      <Component Id="browser_support" Guid="e027d360-a9e1-4bd6-b168-1f56d1fcaf8f" Bitness="always64" Directory="browser_support">
        <File Id="ak_browser_support"
              Source="$(env.ROOT)/bin/browser_support/ak-browser-support.exe"
              KeyPath="true" />
        <File Id="browser_support_json_chrome"
              Source="$(env.PWD)/browser-host-chrome.json" />
        <File Id="browser_support_json_firefox"
              Source="$(env.PWD)/browser-host-firefox.json" />
        <RegistryKey Root="HKLM"
                    Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\io.goauthentik.platform">
          <RegistryValue Type="string" Value="[browser_support]browser-host-chrome.json"/>
        </RegistryKey>
        <RegistryKey Root="HKLM"
                    Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\io.goauthentik.platform">
          <RegistryValue Type="string" Value="[browser_support]browser-host-chrome.json"/>
        </RegistryKey>
        <RegistryKey Root="HKLM"
                    Key="Software\Mozilla\NativeMessagingHosts\io.goauthentik.platform">
          <RegistryValue Type="string" Value="[browser_support]browser-host-firefox.json"/>
        </RegistryKey>
      </Component>
      <Component Id="credential_provider" Guid="4e4c21de-2c3e-4dc0-9a10-42fcd0fd68e1" Bitness="always64" Directory="wcp">
        <util:EventSource Log="authentik"
                          Name="authentik Credential Provider"
                          EventMessageFile="[#wcp_ak_cred_provider_dll]"/>
        <util:EventSource Log="authentik"
                          Name="authentik Credential Provider (Browser)"
                          EventMessageFile="[#wcp_ak_browser_exe]"/>

        <!-- ak_browser.exe runs as this account instead of SYSTEM.
             NetUserAdd folds complexity/banned-word LSA filter rejections
             into the same NERR_PasswordTooShort a real length failure
             would give, and "$" is the WiX preprocessor's substitution
             leader ("$(var.X)"), live before the XML is parsed. Keep
             "Name" in step with credprovider::syscalls::SERVICE_ACCOUNT_NAME. -->
        <util:User Id="wcp_service_account"
                    Name="ak-wcp-browser"
                    Password="qX9m!K2pR7z#VtL4"
                    PasswordNeverExpires="yes"
                    CanNotChangePassword="yes"
                    LogonAsService="yes"
                    UpdateIfExists="yes"
                    RemoveOnUninstall="yes" />

        <CreateFolder Directory="ak_ProgramDataRoot" Subdirectory="wcp-cache">
          <util:PermissionEx User="ak-wcp-browser" GenericAll="yes" />
        </CreateFolder>

        <File Id="wcp_ak_browser_exe" Source="$(env.ROOT)/bin/wcp/ak_browser.exe" />
        <File Id="wcp_ak_cred_provider_dll" Source="$(env.ROOT)/bin/wcp/ak_cred_provider.dll" KeyPath="true" />
        <File Id="wcp_ak_cred_provider_lib" Source="$(env.ROOT)/bin/wcp/ak_cred_provider.lib" />
        <File Id="wcp_ak_cred_provider_pdb" Source="$(env.ROOT)/bin/wcp/ak_cred_provider.pdb" />

        <RegistryKey Root="HKLM"
                    Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{7BCC7941-18BA-4A8E-8E0A-1D0F8E73577A}">
          <RegistryValue Type="string" Value="authentik Credential Provider" />
        </RegistryKey>
        <RegistryKey Root="HKCR"
                    Key="CLSID\{7BCC7941-18BA-4A8E-8E0A-1D0F8E73577A}">
          <RegistryValue Type="string" Value="authentik Credential Provider" />
          <RegistryValue Key="InprocServer32" Type="string" Value="[wcp]ak_cred_provider.dll" />
          <RegistryValue Key="InprocServer32" Type="string" Name="ThreadingModel" Value="Apartment" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <Feature Id="root"
             Title="authentik Platform Agent"
             Level="1"
             Display="expand"
             Description="authentik Platform Agent">
      <Feature Id="agents"
               Title="System &amp; User agents"
               Level="1"
               AllowAbsent="no"
               Description="System and User agents, required.">
        <ComponentRef Id="sysd" />
        <ComponentRef Id="agent" />
        <MergeRef Id="VCRedistCRT" />
      </Feature>
      <Feature Id="cli"
               Title="authentik CLI"
               Level="1"
               AllowAbsent="yes"
               Description="CLI to access applications and services.">
        <ComponentRef Id="cli" />
      </Feature>
      <Feature Id="cli_path"
               Title="Include CLI in PATH"
               Level="1"
               AllowAbsent="yes"
               Description="Update the system's PATH variable to enable easier access to the ak CLI.">
        <ComponentRef Id="cli_path" />
      </Feature>
      <Feature Id="browser_support"
               Title="Browser support"
               Level="1"
               AllowAbsent="yes"
               Description="Helper for use with the browser extension.">
        <ComponentRef Id="browser_support" />
      </Feature>
      <Feature Id="credential_provider"
               Title="Credential provider"
               Level="2"
               AllowAbsent="yes"
               Description="Log into Windows using authentik.">
        <ComponentRef Id="credential_provider" />
      </Feature>
    </Feature>
  </Package>
</Wix>
