<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
        "https://specifications.freedesktop.org/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
    <vendor>authentik Platform Agent</vendor>
    <vendor_url>https://goauthentik.io</vendor_url>
    <action id="io.goauthentik.platform.authorize">
        <description>Authorize actions on behalf of your authentik account.</description>
        <message>Authorize access to your account.</message>
        <defaults>
            <allow_any>auth_self</allow_any>
            <allow_inactive>auth_self</allow_inactive>
            <allow_active>auth_self_keep</allow_active>
        </defaults>
    </action>
    <action id="io.goauthentik.platform.sysd-ctrl-relay">
        <description>Manage authentik system-wide settings (domain enrollment).</description>
        <message>Authenticate as an administrator to manage authentik.</message>
        <icon_name>io.goauthentik.platform</icon_name>
        <defaults>
            <allow_any>auth_admin</allow_any>
            <allow_inactive>auth_admin</allow_inactive>
            <allow_active>auth_admin_keep</allow_active>
        </defaults>
        <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/ak-sysd-ctrl-relay</annotate>
    </action>
</policyconfig>
