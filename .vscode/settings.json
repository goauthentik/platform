{
  "protoc": {
    "options": ["-I=protos/"]
  },
  "rust-analyzer.cargo.targetDir": "cache/_local/",
  "rust-analyzer.testExplorer": true,
  "files.associations": {
    "zshrc": "shellscript",
    "*.hcl": "terraform"
  },
  "gitlens.autolinks": [
      {
          "alphanumeric": true,
          "prefix": "#<num>",
          "url": "https://github.com/goauthentik/platform/issues/<num>",
          "ignoreCase": false
      }
  ]
}
